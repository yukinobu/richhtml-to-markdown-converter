{
  "name": "richtext-to-markdown-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "esbuild scripts/build.ts --bundle --platform=node --packages=external --format=esm --outfile=node_modules/.cache/richhtml/build.mjs && node node_modules/.cache/richhtml/build.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "audit:ts-migration": "esbuild scripts/audit-ts-migration.ts --bundle --platform=node --packages=external --format=esm --outfile=node_modules/.cache/richhtml/audit.mjs && node node_modules/.cache/richhtml/audit.mjs"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
